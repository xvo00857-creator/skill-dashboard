+test("normalizeOrder returns a normalized object for a valid order", () => {
+  const result = normalizeOrder({ id: 42, amount: "19.9" });
+  assert.ok(result !== undefined && result !== null, "result must be defined");
+  assert.equal(typeof result, "object");
+  assert.equal(result.id, 42);
+});
+
+test("normalizeOrder rejects an order without an amount", () => {
+  assert.throws(() => normalizeOrder({ id: 1 }), /amount/);
+});
