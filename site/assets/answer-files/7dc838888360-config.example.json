{
  "_comment": "配置模板。复制为 config.json 后填入真实值；config.json 不得提交版本库。",

  "data_source": {
    "type": "local_json",
    "_options": ["local_json", "feishu_task", "jira"],
    "path": "sample_tasks.json",
    "_note": "接入真实系统时改为 feishu_task/jira，并通过环境变量提供凭据，不得在此文件中填写 token"
  },

  "schedule": {
    "day_of_week": "wednesday",
    "time": "10:00",
    "timezone": "Asia/Shanghai",
    "_note": "建议每周固定时间运行，给团队留出处理时间"
  },

  "overdue_rule": {
    "include_statuses": ["todo", "in_progress", "blocked"],
    "exclude_statuses": ["done"],
    "grace_days": 0,
    "_note": "grace_days>0 时给宽限期；当前为0即截止日次日算逾期"
  },

  "delivery": {
    "channel": "none",
    "_options": ["none", "feishu_webhook", "email"],
    "require_human_confirm": true,
    "dry_run_by_default": true,
    "_note": "channel=none 时只输出到终端；真实发送须显式切换并配置凭据"
  },

  "privacy": {
    "mask_names_in_logs": true,
    "log_retention_days": 30,
    "do_not_store_message_content": true
  }
}
