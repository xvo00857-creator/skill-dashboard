+// Minimal order normalizer.
+// Coerces a numeric string `amount` to a finite number; preserves other fields.
+export function normalizeOrder(order) {
+  if (order === null || typeof order !== "object") {
+    throw new TypeError("normalizeOrder: order must be an object");
+  }
+  const parsed = Number(order.amount);
+  return {
+    ...order,
+    amount: Number.isFinite(parsed) ? parsed : order.amount,
+  };
+}
