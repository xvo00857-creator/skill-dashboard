    {
      "@type": "FAQPage",
      "@id": "https://example.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "这个应用收费吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "【请替换为真实答案：明确说明是否免费、有无内购、是否需要绑定银行卡。】"
          }
        },
        {
          "@type": "Question",
          "name": "我不会用智能手机，有人教我吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "【请替换为真实答案：说明线下社区是否有工作人员手把手教学、是否有志愿者上门、微信客服响应时间。】"
          }
        },
        {
          "@type": "Question",
          "name": "这个应用安全吗？会泄露我的个人信息吗？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "【请替换为真实答案：说明数据保护措施、是否需要实名认证、隐私政策链接。】"
          }
        },
        {
          "@type": "Question",
          "name": "怎么下载和安装？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "【请替换为真实答案：说明应用商店名称、搜索关键词、是否支持微信扫码下载、线下是否可帮忙安装。】"
          }
        },
        {
          "@type": "Question",
          "name": "子女不在身边，遇到问题找谁？",
