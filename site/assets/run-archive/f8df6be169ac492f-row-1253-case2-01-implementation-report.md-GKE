## 5. 改进方案与实现

### 5.1 项目结构

```
gke-improved-project/
├── .dockerignore
├── Dockerfile
├── k8s/
│   └── deployment.yaml
├── package.json
├── src/
│   ├── app.js        # 业务逻辑（normalizeOrder）
│   └── server.js     # HTTP 服务 + 探针端点
└── test.js           # 单元测试（node:test）
```

### 5.2 package.json

```json
{
  "name": "order-normalizer-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal GKE-onboarding sample: order normalization HTTP service with health probes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
```

关键变更：添加 `"type": "module"`、`start` 脚本、`engines` 约束、测试改用 `node --test`。

### 5.3 src/app.js（业务逻辑）

```js
/**
 * 订单规范化工具函数。
 *
 * 输入约束：
 *   - order 必须为非空对象且包含 id 字段；
 *   - amount 可选，缺失时按 0 处理；非数字字符串会被 Number() 转为 NaN，
 *     调用方应在传入前校验，或在返回后检查 Number.isNaN。
 *
 * 输出：
 *   { id: string, amount: number }
 */
export function normalizeOrder(order) {
  if (!order || typeof order !== "object" || order.id === undefined || order.id === null) {
    throw new Error("missing order id");
  }
  const amount = Number(order.amount ?? 0);
  return {
    id: String(order.id),
    amount,
  };
}
```

关键变更：
- 修复原始 `!order.id` 会拒绝 `id: 0` / `id: false` 的逻辑缺陷，改为显式检查 `undefined` / `null`；
- 用 `order.amount ?? 0` 替代 `order.amount || 0`，使 `amount: 0` 不被覆盖为默认值；
- 添加 JSDoc 与输入约束说明。

### 5.4 src/server.js（HTTP 服务）

```js
import http from "node:http";
import { normalizeOrder } from "./app.js";

const PORT = Number(process.env.PORT) || 8080;
const HOST = process.env.HOST || "0.0.0.0";

let isReady = true;

const server = http.createServer((req, res) => {
  if (req.method === "GET" && req.url === "/healthz") {
    res.writeHead(200, { "Content-Type": "text/plain; charset=utf-8" });
    res.end("OK");
    return;
  }

  if (req.method === "GET" && req.url === "/readyz") {
    if (isReady) {
      res.writeHead(200, { "Content-Type": "text/plain; charset=utf-8" });
      res.end("READY");
    } else {
      res.writeHead(503, { "Content-Type": "text/plain; charset=utf-8" });
      res.end("NOT READY");
    }
    return;
  }

  if (req.method === "POST" && req.url === "/normalize") {
    let body = "";
    req.on("data", (chunk) => {
      body += chunk;
      if (body.length > 1_000_000) req.destroy();
    });
    req.on("end", () => {
      try {
        const order = JSON.parse(body || "{}");
        const result = normalizeOrder(order);
        res.writeHead(200, { "Content-Type": "application/json; charset=utf-8" });
        res.end(JSON.stringify(result));
      } catch (err) {
        res.writeHead(400, { "Content-Type": "application/json; charset=utf-8" });
        res.end(JSON.stringify({ error: err.message }));
      }
    });
    return;
  }

  res.writeHead(200, { "Content-Type": "text/plain; charset=utf-8" });
  res.end("order-normalizer-service\n");
});

server.listen(PORT, HOST, () => {
  console.log(`server listening on http://${HOST}:${PORT}`);
});

function shutdown(signal) {
  console.log(`received ${signal}, shutting down`);
  isReady = false;
  server.close(() => {
    console.log("server closed");
    process.exit(0);
  });
  setTimeout(() => process.exit(1), 10_000).unref();
}
process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));

export { server };
```

设计要点：
- `/healthz`（存活）与 `/readyz`（就绪）分离，符合 Skill 探针清单；
- 就绪状态可在优雅关闭时置为 `false`，配合滚动更新排空流量；
- 请求体上限 1 MB 防止 OOM；
- 监听 `SIGTERM` 实现优雅关闭（Kubernetes 终止 Pod 时发送 SIGTERM）；
- 日志全部走 `console.log` → stdout，符合 Skill"日志输出到 stdout/stderr 供 Cloud Logging 收集"的要求。

### 5.5 test.js（单元测试）

```js
import { test } from "node:test";
import assert from "node:assert/strict";
import { normalizeOrder } from "./src/app.js";

test("normalizeOrder: 数字 id 和字符串金额应被正确转换", () => {
  const result = normalizeOrder({ id: 42, amount: "19.9" });
  assert.deepEqual(result, { id: "42", amount: 19.9 });
});

test("normalizeOrder: 缺失 amount 时默认为 0", () => {
  const result = normalizeOrder({ id: "abc" });
  assert.deepEqual(result, { id: "abc", amount: 0 });
});

test("normalizeOrder: 金额为 0 时不应被覆盖", () => {
  const result = normalizeOrder({ id: 1, amount: 0 });
  assert.equal(result.amount, 0);
});

test("normalizeOrder: 缺失 id 应抛出错误", () => {
  assert.throws(() => normalizeOrder({}), /missing order id/);
  assert.throws(() => normalizeOrder(null), /missing order id/);
  assert.throws(() => normalizeOrder(undefined), /missing order id/);
});

test("normalizeOrder: id 为 0 或 false 时应被接受", () => {
  assert.equal(normalizeOrder({ id: 0 }).id, "0");
  assert.equal(normalizeOrder({ id: false }).id, "false");
});
```

使用 Node.js 内置 `node:test` + `node:assert`，零测试框架依赖。

### 5.6 Dockerfile（多阶段、非 root）

```dockerfile
# ---- 构建阶段 ----
FROM node:18-slim AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev || true

COPY src/ ./src/

# ---- 运行阶段 ----
FROM node:18-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/src/ ./src/

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "src/server.js"]
```

符合 Skill 规则 B：多阶段构建、最小基础镜像（slim）、非 root（`USER node`，UID 1000）、日志 stdout。

> 注：Skill 示例使用 Go + distroless；对 Node.js，`gcr.io/distroless/nodejs` 可用但调试不便，且本项目零依赖，`node:18-slim` 已足够小且与 Skill 资产一致。如需进一步缩小可切换到 distroless。

### 5.7 k8s/deployment.yaml（符合 Skill 清单）

```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: order-normalizer
  namespace: default
  labels:
    app: order-normalizer
spec:
  replicas: 2
  selector:
    matchLabels:
      app: order-normalizer
  template:
    metadata:
      labels:
        app: order-normalizer
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: order-normalizer
          image: <REGION>-docker.pkg.dev/<PROJECT>/<REPO>/order-normalizer:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 8080
              protocol: TCP
          env:
            - name: NODE_ENV
              value: "production"
            - name: PORT
              value: "8080"
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "200m"
              memory: "256Mi"
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
---
apiVersion: v1
kind: Service
metadata:
  name: order-normalizer
  namespace: default
  labels:
    app: order-normalizer
spec:
  type: ClusterIP
  selector:
    app: order-normalizer
  ports:
    - name: http
      port: 80
      targetPort: 8080
      protocol: TCP
```

Skill 清单逐项核对：

| 清单项 | 状态 |
|---|---|
| 资源 requests/limits | ✅ cpu 100m/200m, memory 128Mi/256Mi |
| livenessProbe | ✅ /healthz |
| readinessProbe | ✅ /readyz |
| 至少 2 副本 | ✅ replicas: 2 |
| Service 类型恰当 | ✅ ClusterIP（内部） |
| 非 root | ✅ runAsNonRoot + runAsUser 1000 |
| 只读根文件系统 | ✅ readOnlyRootFilesystem: true |
| 禁用特权升级 | ✅ allowPrivilegeEscalation: false |
| 丢弃所有 Linux capabilities | ✅ drop: ALL |
| seccomp RuntimeDefault | ✅ |
| 不自动挂载 SA Token | ✅ automountServiceAccountToken: false |

